rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }
    function souAdmin() { return logado() && meuPerfil() == 'admin'; }

    // Um fornecedor só pode LER o próprio documento (nunca listar os outros,
    // então nunca descobre nome/existência de outro fornecedor por aqui).
    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || souAdmin());
      allow list: if souAdmin();
      allow write: if souAdmin();
    }

    match /clientes/{id} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // Catálogo de peças: de-para entre o PN interno (MRHB) e o PN do
    // cliente, usado para preencher a ocorrência automaticamente.
    match /pnClientes/{id} {
      allow read: if logado();
      allow write: if souAdmin();
    }

    // Um fornecedor só lê ocorrências cujo usuarioId seja o dele mesmo.
    // Isso vale tanto para leitura de um documento quanto para consultas —
    // se o app esquecer de filtrar por usuarioId, o Firestore recusa a
    // consulta inteira em vez de vazar dado de outro fornecedor.
    match /ocorrencias/{id} {
      allow read: if souAdmin() || (logado() && resource.data.usuarioId == request.auth.uid);
      allow create, update, delete: if souAdmin();
    }

    // Mesmo princípio para apontamentos, e na criação confere também que
    // a ocorrência referenciada realmente pertence a quem está gravando —
    // impede um fornecedor de apontar peça em ocorrência de outro.
    match /apontamentos/{id} {
      allow read: if souAdmin() || (logado() && resource.data.usuarioId == request.auth.uid);
      allow create: if logado() &&
        request.resource.data.usuarioId == request.auth.uid &&
        get(/databases/$(database)/documents/ocorrencias/$(request.resource.data.ocorrenciaId)).data.usuarioId == request.auth.uid;
      allow update, delete: if souAdmin();
    }
  }
}
